# URL publik situs, tanpa garis miring di akhir.
# Contoh: https://undangan-digital.vercel.app
NEXT_PUBLIC_SITE_URL=

# Nama brand yang tampil di landing dan metadata.
NEXT_PUBLIC_BRAND_NAME=

# Kredensial Supabase. Service role key hanya dipakai di server.
# Jangan pernah memberi prefix NEXT_PUBLIC_ pada nilai ini.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Penyedia LLM untuk Bantu Tulis (dipakai mulai M8).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Paket default untuk undangan baru: free atau premium.
DEFAULT_PLAN=premium

# Salt untuk hashing IP tamu pada rate limit RSVP.
IP_HASH_SALT=
